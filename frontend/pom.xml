<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.kochev</groupId>
    <artifactId>mvn-spring-angular-app</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>frontend</artifactId>
  <name>frontend</name>

  <build>
    <plugins>
      <!-- 1. Standard clean plugin that deletes files during the mvn clean phase -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <failOnError>false</failOnError>
          <filesets>
            <fileset>
              <directory>.</directory>
              <includes>
                <include>dist/**/*.*</include>
              </includes>
              <followSymlinks>false</followSymlinks>
            </fileset>
            <fileset>
              <directory>../backend/src/main/resources/static</directory>
            </fileset>
          </filesets>
        </configuration>
      </plugin>

      <!-- 2. Build Angular App -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <!-- Install the locked frontend dependencies (includes the Angular CLI) -->
          <execution>
            <id>npm-ci</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <workingDirectory>.</workingDirectory>
              <executable>npm</executable>
              <arguments>
                <argument>ci</argument>
              </arguments>
            </configuration>
          </execution>

          <execution>
            <id>angular-cli-build</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <workingDirectory>.</workingDirectory>
              <executable>npx</executable>
              <arguments>
                <argument>ng</argument>
                <argument>build</argument>
                <argument>--configuration</argument>
                <argument>production</argument>
              </arguments>
            </configuration>
          </execution>

          <!-- 3. Copy Angular build to Spring Boot static folder -->
          <execution>
            <id>copy-dist-to-static</id>
            <phase>process-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>cp</executable>
              <workingDirectory>.</workingDirectory>
              <arguments>
                <argument>-r</argument>
                <argument>dist/frontend/browser/.</argument>
                <argument>../backend/src/main/resources/static/</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

</project>
